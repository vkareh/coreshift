# The bases are pinned by digest and stay inside Red Hat's UBI family;
# README.md records how they were chosen. The final stage is micro, the
# smallest variant: it runs the control plane binaries, dynamically
# linked against glibc, but ships no CA certificates, so the build
# copies the bundle from the larger stage and points the standard SSL
# environment variable at it; the Go binaries then trust the release
# registry they pull from at run time.
FROM registry.access.redhat.com/ubi10/ubi-minimal@sha256:ab67cd02caf8706e34a695a1432ebe965934f6128ec352a6c3f4048b43a4fb5e AS certificates
FROM registry.access.redhat.com/ubi10/ubi-micro@sha256:1c105e547de5d9e0bc20d06ebabee73b20bc6bba994c50ae3e207684fd8bef2b
COPY --from=certificates /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
ENV SSL_CERT_FILE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem

# The running binary is the only file the build context carries; the
# gpgme libraries it needs are embedded in it and written out at boot.
COPY coreshift /usr/local/bin/coreshift

# Marks in-container execution: the API server binds every interface so
# a published port reaches it.
ENV CORESHIFT_CONTAINER=1

ENTRYPOINT ["/usr/local/bin/coreshift", "run", "cluster"]
